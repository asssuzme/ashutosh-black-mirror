# Slack Configuration
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here
SLACK_APP_TOKEN=xapp-your-app-token-here

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here

# Admin Configuration
ADMIN_USER_ID=U01234567890
ADMIN_DM_CHANNEL_ID=D01234567890

# Monitored Channels (comma-separated)
SALES_CHANNEL_ID=C01234567890
OUTREACH_CHANNEL_ID=C01234567891
SHITPOSTERS_CHANNEL_ID=C01234567892

# Timezone
TIMEZONE=Asia/Kolkata

# Bot Configuration
BOT_NAME=AI Boss
ENVIRONMENT=development

# Learning Configuration
LEARNING_ENABLED=true
LEARNING_CRON=0 22 * * *

# Database (optional - uses JSON files by default)
USE_DATABASE=false
DB_PATH=./memory/aiboss.db
